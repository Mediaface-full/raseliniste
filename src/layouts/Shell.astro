---
import Base from "./Base.astro";
import LogoutButton from "@/components/LogoutButton";
import SidebarToggle from "@/components/SidebarToggle";
import ThemeToggle from "@/components/ThemeToggle";
import GideonWordmark from "@/components/GideonWordmark";
import SwUpdateBanner from "@/components/SwUpdateBanner";
// DOČASNÉ (Gideon 2026-08-08): komentování UI přímo v prohlížeči.
// Až se doladí → smazat import + mount + src/components/Anotace.tsx.
import Anotace from "@/components/Anotace";
import { Icon } from "astro-icon/components";
import { readSession } from "@/lib/session";
import { getPostaBadgeCount } from "@/lib/posta-badge";

interface Props {
  title: string;
  username: string;
  heading?: string;
  breadcrumb?: { label: string; href?: string }[];
}

const { title, username, heading, breadcrumb = [] } = Astro.props;
const path = Astro.url.pathname;

// Sidebar badge counters — server-side, cache 60s in-memory.
// Jen pokud existuje session (na public stránkách neřešíme).
const session = await readSession(Astro.cookies);
let postaBadge = 0;
if (session) {
  try {
    postaBadge = await getPostaBadgeCount(session.uid);
  } catch {
    // Pošta není nakonfigurovaná, count = 0. Tichý fail, sidebar nesmí padnout.
  }
}

type NavItem = {
  href: string;
  label: string;
  icon: string;
  tint: string;
  enabled?: boolean;
  badge?: number;
  /** Prefixy cest, při kterých je položka aktivní (mimo vlastní href). */
  match?: string[];
  /** Podmenu — vykreslí se jako rozbalovací <details>, otevřené když je aktivní dítě. */
  children?: NavItem[];
};

// Dnešní datum v Praha TZ (UX audit: toISOString() = UTC → po 22:00 letního
// času odkazovalo na včerejšek)
const todayPrague = new Intl.DateTimeFormat("en-CA", { timeZone: "Europe/Prague" }).format(new Date());

/**
 * UX audit 2026-09-06 (R3): menu přeskupené podle toho, CO chce Gideon udělat
 * (ne podle technické domény). Dřív: „Organizace" 16 položek, 6 mrtvých
 * odkazů na 404, Page Links v „Přehledu". Teď: 7 skupin, každá max ~6 položek,
 * nastavení kalendáře a pošty v podmenu.
 */
const nav: { group: string; items: NavItem[] }[] = [
  { group: "Dnes", items: [
    { href: "/", label: "Dashboard", icon: "lucide:layout-dashboard", tint: "peach" },
    { href: `/day/${todayPrague}`, label: "Dnešní den", icon: "lucide:sun", tint: "butter", match: ["/day/", "/dnes"] },
    { href: "/notifikace", label: "Notifikace", icon: "lucide:bell", tint: "rose" },
    { href: "/start", label: "Start (mobil)", icon: "lucide:smartphone", tint: "sky" },
  ]},
  { group: "Vstupy", items: [
    { href: "/ozvena", label: "Ozvěna — nahrát", icon: "lucide:mic", tint: "peach", match: ["/ukoly/audio", "/diktat"] },
    { href: "/quickadd", label: "Rychlé zadání", icon: "lucide:zap", tint: "sky" },
    { href: "/capture", label: "Ruční vstup", icon: "lucide:edit-3", tint: "mint" },
    { href: "/triage", label: "Triage", icon: "lucide:inbox", tint: "peach" },
    { href: "/tasks", label: "Capture inbox", icon: "lucide:list-checks", tint: "mint" },
  ]},
  { group: "Kalendář", items: [
    { href: "/calendar", label: "Kalendář", icon: "lucide:calendar", tint: "sky", match: ["/calendar/tyden", "/calendar/mesic"] },
    { href: "/calendar/invite", label: "Pozvánka na schůzku", icon: "lucide:send", tint: "sage" },
    { href: "/calendar/away", label: "Dovolená / nomád", icon: "lucide:plane", tint: "rose" },
    { href: "/calendar/settings", label: "Nastavení kalendáře", icon: "lucide:settings-2", tint: "sky", children: [
      { href: "/calendar/settings", label: "Booking — pravidla", icon: "lucide:sliders-horizontal", tint: "sky" },
      { href: "/calendar/locations", label: "Lokace", icon: "lucide:map-pin", tint: "lavender" },
      { href: "/settings/ritualy", label: "Rituály", icon: "lucide:repeat", tint: "butter" },
      { href: "/settings/local-calendars", label: "Nahrané kalendáře", icon: "lucide:calendar-plus", tint: "sage" },
    ]},
  ]},
  { group: "Práce", items: [
    { href: "/ukoly", label: "Úkoly", icon: "lucide:check-square", tint: "peach" },
    { href: "/planovani", label: "Plánování týdne", icon: "lucide:kanban", tint: "sky" },
    { href: "/studna", label: "Studánka", icon: "lucide:waves", tint: "butter" },
    { href: "/prskavka", label: "Prskavka", icon: "lucide:sparkles", tint: "butter" },
    { href: "/projekt", label: "Timeline", icon: "lucide:gantt-chart-square", tint: "lavender" },
    { href: "/zeptat-se", label: "Zeptat se (AI)", icon: "lucide:message-circle-question", tint: "rose" },
  ]},
  { group: "Obsah", items: [
    { href: "/denik", label: "Deník", icon: "lucide:book-open", tint: "butter", match: ["/journal"] },
    { href: "/notes", label: "Poznámky", icon: "lucide:notebook-pen", tint: "mint" },
    { href: "/letters", label: "Dopisy", icon: "lucide:mail-plus", tint: "butter" },
    { href: "/spiz", label: "Spíž", icon: "lucide:archive", tint: "sage" },
  ]},
  { group: "Komunikace", items: [
    { href: "/posta", label: "Pošta", icon: "lucide:mail", tint: "cool-blue", badge: postaBadge, children: [
      { href: "/posta/uklid", label: "Úklid pošty", icon: "lucide:trash-2", tint: "rose" },
    ]},
  ]},
  { group: "Lidé a data", items: [
    { href: "/contacts", label: "Kontakty", icon: "lucide:users", tint: "lavender" },
    { href: "/vyroci", label: "Výročí", icon: "lucide:calendar-heart", tint: "rose" },
    { href: "/health", label: "Zdraví", icon: "lucide:heart-pulse", tint: "rose" },
    { href: "/zijes", label: "ŽIJEŠ?", icon: "lucide:activity", tint: "rose" },
    { href: "/bwmys", label: "Myši (rozhodování)", icon: "lucide:arrow-left-right", tint: "lavender" },
    { href: "/firewall", label: "Firewall", icon: "lucide:shield", tint: "peach" },
  ]},
  { group: "Systém", items: [
    { href: "/settings", label: "Nastavení", icon: "lucide:settings", tint: "lavender", children: [
      { href: "/settings/page-links", label: "Page Links", icon: "lucide:link", tint: "sky" },
      { href: "/settings/integrations/google", label: "Integrace", icon: "lucide:plug", tint: "mint", match: ["/settings/integrations", "/settings/whatsapp", "/settings/push", "/settings/reports"] },
    ]},
    { href: "/navody", label: "Návody", icon: "lucide:book-marked", tint: "butter" },
  ]},
];

// Aktivní = nejdelší shoda napříč VŠEMI položkami (dřív prefix → na
// /settings/page-links svítilo „Page Links" i „Nastavení" zároveň).
const allItems: NavItem[] = nav.flatMap((g) => g.items.flatMap((i) => [i, ...(i.children ?? [])]));
const matchLen = (item: NavItem): number => {
  const cands = [item.href, ...(item.match ?? [])];
  let best = -1;
  for (const c of cands) {
    if (c === "/") { if (path === "/") best = Math.max(best, 1); continue; }
    if (path === c || path.startsWith(c.endsWith("/") ? c : c + "/")) best = Math.max(best, c.length);
  }
  return best;
};
const bestLen = Math.max(...allItems.map(matchLen));
const activeHref = bestLen < 0 ? null : allItems.find((i) => matchLen(i) === bestLen)?.href ?? null;
const isActive = (item: NavItem) => item.href === activeHref && matchLen(item) === bestLen;
const hasActiveChild = (item: NavItem) => (item.children ?? []).some((c) => isActive(c));
---

<Base title={title}>
  <div
    data-shell
    class="min-h-screen relative z-10 lg:grid lg:grid-cols-[260px_1fr] lg:gap-3 lg:p-3 p-2
           lg:[&[data-sidebar-collapsed=true]]:grid-cols-[0px_1fr] lg:[&[data-sidebar-collapsed=true]]:gap-0
           lg:transition-[grid-template-columns,gap] lg:duration-200 lg:ease-out"
  >
    {/* Backdrop (mobile only, když je sidebar otevřený) */}
    <div
      class="fixed inset-0 bg-black/40 backdrop-blur-sm z-30 opacity-0 pointer-events-none transition-opacity lg:hidden data-[open]:opacity-100 data-[open]:pointer-events-auto"
      data-sidebar-backdrop
    ></div>

    {/* Sidebar — glass panel; lg: v gridu, pod lg: off-canvas (otevírá se hamburgerem).
        Desktop collapse: data-collapsed=true → opacity 0 + neviditelný, grid kolony se zmenší. */}
    <aside
      data-sidebar
      class="glass rounded-xl flex flex-col overflow-hidden
             lg:sticky lg:top-3 lg:h-[calc(100vh-1.5rem)]
             fixed inset-y-2 left-2 w-[260px] z-40 transform -translate-x-[calc(100%+1rem)] transition-transform
             data-[open]:translate-x-0
             lg:static lg:translate-x-0 lg:inset-auto lg:w-auto
             lg:transition-[opacity,transform] lg:duration-200
             lg:data-[collapsed=true]:opacity-0 lg:data-[collapsed=true]:-translate-x-4 lg:data-[collapsed=true]:pointer-events-none"
    >
      <div class="px-5 py-5 border-b border-border">
        <a href="/start" class="flex flex-col gap-1 group" aria-label="Gide-on — Rašeliniště">
          <GideonWordmark size="sm" />
          <span class="text-[10px] uppercase tracking-widest text-muted-foreground font-mono">
            Rašeliniště · v0.2
          </span>
        </a>
      </div>

      <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-5 text-[15px]">
        {nav.map((section) => (
          <div>
            <div class="px-2.5 mb-2 text-[11px] uppercase tracking-[0.18em] text-muted-foreground font-mono font-medium">
              {section.group}
            </div>
            <ul class="space-y-0.5">
              {section.items.map((item) => {
                const active = isActive(item);
                const childActive = hasActiveChild(item);
                const rowClass = [
                  "relative flex items-center gap-3 px-3 py-2.5 rounded-md transition-colors",
                  active
                    ? "bg-accent text-foreground font-medium"
                    : "text-foreground/80 hover:bg-accent hover:text-foreground",
                ];
                const inner = (
                  <>
                    {active && (
                      <span class="absolute left-0 top-2 bottom-2 w-[3px] rounded-r" style="background: var(--c);"></span>
                    )}
                    <Icon name={item.icon} class="size-5 shrink-0" style="color: var(--c);" />
                    <span class="truncate">{item.label}</span>
                    {item.badge !== undefined && item.badge > 0 && (
                      <span
                        class="ml-auto inline-flex items-center justify-center min-w-[1.25rem] h-5 px-1.5 rounded-full text-xs font-mono font-medium"
                        style="background: color-mix(in oklch, var(--c) 22%, transparent); color: var(--c);"
                        title="Aktivní action_required (urgency high nebo escalation)"
                      >
                        {item.badge}
                      </span>
                    )}
                  </>
                );
                if (!item.children) {
                  return (
                    <li>
                      <a href={item.href} style={`--c: var(--tint-${item.tint});`} class:list={rowClass}>{inner}</a>
                    </li>
                  );
                }
                // Podmenu: hlavní řádek je odkaz, šipka rozbaluje; otevřené když je aktivní dítě
                return (
                  <li>
                    <details class="group/sub" open={active || childActive}>
                      <summary class="list-none cursor-pointer [&::-webkit-details-marker]:hidden">
                        <div style={`--c: var(--tint-${item.tint});`} class:list={[...rowClass, "pr-2"]}>
                          <a href={item.href} class="flex items-center gap-3 flex-1 min-w-0">{inner}</a>
                          <Icon name="lucide:chevron-down" class="size-4 shrink-0 text-muted-foreground transition-transform group-open/sub:rotate-180" />
                        </div>
                      </summary>
                      <ul class="mt-0.5 ml-4 pl-3 border-l border-border space-y-0.5">
                        {item.children.map((child) => {
                          const cActive = isActive(child);
                          return (
                            <li>
                              <a
                                href={child.href}
                                style={`--c: var(--tint-${child.tint});`}
                                class:list={[
                                  "relative flex items-center gap-2.5 px-2.5 py-2 rounded-md text-[14px] transition-colors",
                                  cActive ? "bg-accent text-foreground font-medium" : "text-foreground/75 hover:bg-accent hover:text-foreground",
                                ]}
                              >
                                <Icon name={child.icon} class="size-4 shrink-0" style="color: var(--c);" />
                                <span class="truncate">{child.label}</span>
                              </a>
                            </li>
                          );
                        })}
                      </ul>
                    </details>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </nav>

      <div class="border-t border-border p-3 flex items-center gap-2.5">
        <div class="size-8 rounded-md bg-foreground text-background flex items-center justify-center font-sans font-bold text-sm">
          {username.slice(0, 1).toUpperCase()}
        </div>
        <div class="flex-1 min-w-0">
          <div class="text-sm truncate text-foreground">{username}</div>
          <div class="text-[10px] uppercase tracking-widest text-muted-foreground font-mono">
            online
          </div>
        </div>
        <LogoutButton client:load />
      </div>
    </aside>

    {/* Main column — topbar + content, žádný outer glass (content karty nesou glass samy) */}
    <div class="flex flex-col min-w-0 gap-3">
      <header class="glass rounded-xl h-16 px-4 lg:px-5 flex items-center gap-3">
        <SidebarToggle client:load />
        {/* UX audit R3/B2: Start = mobilní rozcestník. Neutrální vzhled (tint jako CTA je mimo brand), na desktopu je domů Dashboard. */}
        <a
          href="/start"
          class="h-10 px-3 rounded-md border border-border hover:bg-accent flex items-center gap-2 text-muted-foreground hover:text-foreground transition-colors shrink-0 lg:hidden"
          aria-label="Start — mobilní rozcestník"
          title="Start"
        >
          <Icon name="lucide:home" class="size-[18px]" />
          <span class="text-sm hidden sm:inline">Start</span>
        </a>
        <div class="flex items-center gap-2.5 text-base text-muted-foreground min-w-0">
          {breadcrumb.length === 0 ? (
            <span class="text-foreground font-medium truncate">{heading ?? title}</span>
          ) : (
            breadcrumb.map((crumb, i) => (
              <>
                {crumb.href ? (
                  <a href={crumb.href} class="hover:text-foreground transition-colors truncate">{crumb.label}</a>
                ) : (
                  <span class="text-foreground font-medium truncate">{crumb.label}</span>
                )}
                {i < breadcrumb.length - 1 && (
                  <Icon name="lucide:chevron-right" class="size-4 text-muted-foreground/60 shrink-0" />
                )}
              </>
            ))
          )}
        </div>

        <div class="ml-auto flex items-center gap-1">
          {/* Petr 2026-06-18 redesign — light/dark toggle */}
          <ThemeToggle size="compact" client:load />
          {/* Rychlé přepínače pohledů kalendáře — Petr je chce v topbaru */}
          <a
            href="/dnes"
            class="h-10 px-3 rounded-md hover:bg-accent text-sm font-mono text-muted-foreground hover:text-foreground flex items-center gap-2 transition-colors"
            title="Dnešní den"
          >
            <Icon name="lucide:calendar-clock" class="size-[18px]" />
            <span class="hidden sm:inline">Den</span>
          </a>
          <a
            href="/calendar/tyden"
            class="h-10 px-3 rounded-md hover:bg-accent text-sm font-mono text-muted-foreground hover:text-foreground flex items-center gap-2 transition-colors"
            title="Týdenní pohled"
          >
            <Icon name="lucide:calendar-days" class="size-[18px]" />
            <span class="hidden sm:inline">Týden</span>
          </a>
          <a
            href="/calendar/mesic"
            class="h-10 px-3 rounded-md hover:bg-accent text-sm font-mono text-muted-foreground hover:text-foreground flex items-center gap-2 transition-colors"
            title="Měsíční pohled"
          >
            <Icon name="lucide:calendar" class="size-[18px]" />
            <span class="hidden sm:inline">Měsíc</span>
          </a>
          <span class="hidden md:inline-block w-px h-6 bg-border mx-1" />
          {/* UX audit R3: tlačítko „Hledat ⌘K" bylo bez funkce → vede na Zeptat se (AI hledání nad daty), ⌘K zkratka níže */}
          <a href="/zeptat-se" id="topbar-search" class="h-10 px-3 rounded-md hover:bg-accent text-sm text-muted-foreground hover:text-foreground flex items-center gap-2 transition-colors" aria-label="Zeptat se — hledání napříč daty" title="Zeptat se (⌘K)">
            <Icon name="lucide:search" class="size-[18px]" />
            <span class="hidden md:inline">Zeptat se</span>
            <span class="hidden md:inline font-mono text-xs text-muted-foreground/80">⌘K</span>
          </a>
          <a href="/settings" class="size-10 rounded-md hover:bg-accent flex items-center justify-center text-muted-foreground hover:text-foreground transition-colors" aria-label="Nastavení">
            <Icon name="lucide:settings" class="size-[18px]" />
          </a>
        </div>
      </header>

      <main class="flex-1 min-w-0 overflow-y-auto px-1 pb-3">
        {heading && <h1 class="font-sans font-bold text-4xl mb-6 tracking-[-0.04em] leading-tight">{heading}</h1>}
        <slot />
      </main>
    </div>
  </div>
  <script>
    // ⌘K / Ctrl+K → Zeptat se (UX audit R3)
    document.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        window.location.href = "/zeptat-se";
      }
    });
  </script>
  <SwUpdateBanner client:load />
  <Anotace client:load />

  {/* iOS PWA externí odkazy: zachytávač je od 2026-08-06 v Base.astro
      (platí i pro /start a veřejné stránky). */}
</Base>
