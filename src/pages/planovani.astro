---
import Shell from "../layouts/Shell.astro";
import TrencadisBoard from "../components/TrencadisBoard";
import WeekTemplateEditor from "../components/WeekTemplateEditor";
import DigestSettings from "../components/DigestSettings";
import type { DayMode } from "../lib/week-template";
import { buildPlanningBoardData } from "../lib/planning-board-data";
import { prisma } from "../lib/db";
import { readSession } from "../lib/session";

// Fonty trencadís designu (DESIGN/board_work) — jen na této stránce
import "@fontsource/cormorant-garamond/600.css";
import "@fontsource/cormorant-garamond/500-italic.css";
import "@fontsource/barlow/400.css";
import "@fontsource/barlow/500.css";
import "@fontsource/barlow/600.css";
import "@fontsource/barlow-semi-condensed/500.css";
import "@fontsource/barlow-semi-condensed/600.css";

const session = await readSession(Astro.cookies);
if (!session) return Astro.redirect("/login");

const user = await prisma.user.findUnique({
  where: { id: session.uid },
  select: { username: true },
});
if (!user) return Astro.redirect("/login");

const data = await buildPlanningBoardData(session.uid, Astro.url.searchParams.get("w"), "/planovani");

const templateRows = await prisma.planningDayTemplate.findMany({
  where: { userId: session.uid },
  orderBy: { weekday: "asc" },
  select: { weekday: true, mode: true, label: true },
});

// Existuje aktivní sdílení? → zobrazit tlačítko „Zrušit sdílení"
const planningSettings = await prisma.planningSettings.findUnique({
  where: { userId: session.uid },
  select: { shareToken: true },
});
const hasShare = Boolean(planningSettings?.shareToken);
---

<Shell
  title="Plánování · Rašeliniště"
  username={user.username}
  breadcrumb={[{ label: "Práce" }, { label: "Plánování" }]}
>
  <div class="space-y-3">
    {/* Parchment panel — trencadís canvas (DESIGN/board_work) */}
    <div class="trc-canvas rounded-[14px] px-4 py-5 lg:px-10 lg:pt-7 lg:pb-9" style="background: #EFE7D6; color: #2A241C;">
      {/* Header dle návrhu */}
      <div class="flex items-end justify-between flex-wrap" style="gap: 24px; margin-bottom: 16px;">
        <div style="min-width: 0;">
          <div style="font-family: 'Barlow Semi Condensed', sans-serif; letter-spacing: 0.42em; text-transform: uppercase; font-size: 12px; color: #C1553A; font-weight: 600; margin-bottom: 10px;">Dílna trencadís · Kanban</div>
          <h1 style="font-family: 'Cormorant Garamond', serif; font-weight: 600; font-size: 46px; line-height: 1.1; margin: 0; color: #17403f; white-space: nowrap;">Gidiho <span style="font-style: italic; color: #C1553A;">Týden</span></h1>
          <div style="font-family: 'Barlow', sans-serif; font-size: 14px; color: #5c5344; margin-top: 6px;">Týdenní plán dílny — pondělí až pátek</div>
        </div>
        <div class="flex items-center flex-wrap" style="gap: 12px;">
          {!data.isCurrentWeek && (
            <a href="/planovani" style="font-family: 'Barlow Semi Condensed', sans-serif; text-transform: uppercase; letter-spacing: 0.16em; font-size: 12px; font-weight: 600; color: #17789E; padding: 10px 6px;">Dnes</a>
          )}
          <button
            type="button"
            id="trc-share"
            style="font-family: 'Barlow Semi Condensed', sans-serif; text-transform: uppercase; letter-spacing: 0.16em; font-size: 12px; font-weight: 600; color: #5c5344; padding: 10px 16px; border: 1px solid rgba(42,36,28,0.22); border-radius: 4px; background: none; cursor: pointer;"
          >⎘ Sdílet</button>
          <button
            type="button"
            id="trc-unshare"
            class={hasShare ? "" : "hidden"}
            title="Zneplatní odkaz pro kolegyni — stránka /b/… přestane fungovat"
            style="font-family: 'Barlow Semi Condensed', sans-serif; text-transform: uppercase; letter-spacing: 0.16em; font-size: 12px; font-weight: 600; color: #A8412C; padding: 10px 16px; border: 1px solid rgba(168,65,44,0.35); border-radius: 4px; background: none; cursor: pointer;"
          >✕ Zrušit sdílení</button>
          <button
            type="button"
            id="trc-fullscreen"
            class="hidden lg:block"
            style="font-family: 'Barlow Semi Condensed', sans-serif; text-transform: uppercase; letter-spacing: 0.16em; font-size: 12px; font-weight: 600; color: #5c5344; padding: 10px 16px; border: 1px solid rgba(42,36,28,0.22); border-radius: 4px; background: none; cursor: pointer;"
          >⛶ Na celou šířku</button>
        </div>
      </div>

      <TrencadisBoard
        client:load
        weekStart={data.weekStart}
        days={data.days}
        initialCards={data.initialCards}
        initialBlocks={data.initialBlocks}
        backlogTotal={data.backlogTotal}
        clientTotals={data.clientTotals}
        weekTabs={data.weekTabs}
        prevHref={data.prevHref}
        nextHref={data.nextHref}
      />
    </div>

    <WeekTemplateEditor
      client:load
      initialDays={templateRows.map((r) => ({ weekday: r.weekday, mode: r.mode as DayMode, label: r.label }))}
    />
    <DigestSettings client:load />
  </div>

  <script>
    // „Na celou šířku" = deleguje na SidebarToggle (konzistentní React stav
    // + localStorage). Label se synchronizuje z data-shell atributu.
    const btn = document.getElementById("trc-fullscreen");
    const shell = document.querySelector("[data-shell]");
    function syncLabel() {
      const collapsed = shell?.getAttribute("data-sidebar-collapsed") === "true";
      if (btn) btn.textContent = collapsed ? "⛶ Zpět do okna" : "⛶ Na celou šířku";
    }
    btn?.addEventListener("click", () => {
      (document.querySelector("[data-sidebar-toggle]") as HTMLElement | null)?.click();
    });
    if (shell) new MutationObserver(syncLabel).observe(shell, { attributes: true, attributeFilter: ["data-sidebar-collapsed"] });
    syncLabel();

    // „Sdílet" — vygeneruje (nebo vrátí existující) read-only link pro
    // kolegyni a zkopíruje ho do schránky.
    const shareBtn = document.getElementById("trc-share");
    const unshareBtn = document.getElementById("trc-unshare");
    shareBtn?.addEventListener("click", async () => {
      shareBtn.textContent = "⎘ Vytvářím…";
      try {
        const res = await fetch("/api/planovani/sdileni", { method: "POST" });
        const d = await res.json();
        if (!res.ok || !d.url) throw new Error(d.error ?? "Nepodařilo se");
        await navigator.clipboard.writeText(d.url).catch(() => null);
        shareBtn.textContent = "✓ Odkaz zkopírován";
        unshareBtn?.classList.remove("hidden");
        window.prompt("Read-only odkaz pro kolegyni (zkopírován do schránky):", d.url);
      } catch {
        shareBtn.textContent = "⎘ Sdílet — chyba";
      } finally {
        setTimeout(() => { shareBtn.textContent = "⎘ Sdílet"; }, 4000);
      }
    });

    // „Zrušit sdílení" — zneplatní token; příští Sdílet vygeneruje NOVÝ odkaz.
    unshareBtn?.addEventListener("click", async () => {
      if (!confirm("Zrušit sdílení? Odkaz, který má kolegyně, přestane fungovat.")) return;
      const res = await fetch("/api/planovani/sdileni", { method: "DELETE" }).catch(() => null);
      if (res?.ok) {
        unshareBtn.classList.add("hidden");
      } else {
        unshareBtn.textContent = "✕ Zrušení selhalo";
        setTimeout(() => { unshareBtn.textContent = "✕ Zrušit sdílení"; }, 4000);
      }
    });
  </script>
</Shell>
